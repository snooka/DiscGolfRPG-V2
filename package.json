{
  "name": "disc-golf-rpg",
  "private": true,
  "version": "2.2.1",
  "androidVersionCode": 18,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test \"tests/**/*.test.ts\"",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && npx cap sync android && node scripts/android-permissions.mjs && node scripts/android-version.mjs",
    "icons": "npx @capacitor/assets generate --android --assetPath resources",
    "cap:open": "npx cap open android",
    "apk": "npm run build && npx cap sync android && node scripts/android-permissions.mjs && node scripts/android-version.mjs && cd android && .\\gradlew.bat assembleDebug",
    "css": "tailwindcss -i src/tailwind.css -o src/tailwind.generated.css --minify",
    "css:watch": "tailwindcss -i src/tailwind.css -o src/tailwind.generated.css --watch",
    "predev": "npm run css",
    "prebuild": "npm run css"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
