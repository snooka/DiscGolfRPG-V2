# Kopier denne filen til ".env" og fyll inn verdiene fra Supabase:
# Project Settings → API → «Project URL» og «anon public key».
# (anon-nøkkelen er laget for å ligge i appen – sikkerheten ligger i RLS-reglene i supabase/schema.sql.
#  Bruk ALDRI «service_role»-nøkkelen her.)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Valgfritt: fast offentlig adresse til nettversjonen (PWA), brukes i e-postlenker i stedet for adressen
# nettleseren står på. Android-appen sender ingen lenke (passordkoden skrives inn i appen).
# VITE_PUBLIC_APP_URL=https://din-app.example.com
